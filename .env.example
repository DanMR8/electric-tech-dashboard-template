# Modo de integración de la capa API:
#   demo = autenticación local autocontenida (localStorage), sin backend.
#   http = conexión a un backend REST con sesión administrada por cookie.
VITE_AUTH_MODE=demo

# Solo aplica en modo http. Prefijo de las rutas de autenticación.
VITE_API_PREFIX=/api
VITE_API_BASE_URL=

# Solo aplica en modo http. Ruta del endpoint de salud.
VITE_HEALTH_URL=/health

# Proxy del servidor de desarrollo (solo 'pnpm dev'): destino del backend local.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8550